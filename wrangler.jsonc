{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "birge",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [{ "pattern": "birge.atla.kz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
